{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ezerwright-contact",
  "main": "worker/contact.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "ezerwright.com/api/*", "zone_name": "ezerwright.com"}],
  "vars": {"CONTACT_FROM": "hello@ezerwright.com"},
  "send_email": [{"name": "SEND_EMAIL", "destination_address": "owner@example.invalid"}],
  "ratelimits": [{"name": "CONTACT_RATE_LIMIT", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}]
}
