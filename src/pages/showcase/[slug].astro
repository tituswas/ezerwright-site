---
import Layout from '../../layouts/Layout.astro';
import {site} from '../../config/site.mjs';
const concepts = {
 exterior:{name:'Rinse & Rise',brand:'VOLT / WASH',kind:'Exterior cleaning',tag:'ENERGY IN EVERY DETAIL',title:'Pure impact. No compromise.',description:'For beautiful homes and the spaces that surround them.',services:['House exteriors','Driveways and patios','Commercial cleaning'],color:'exterior'},
 pool:{name:'Blue Hour',brand:'LUMA / POOLS',kind:'Pool care',tag:'THE ART OF CLEAR WATER',title:'A little more blue.',description:'Your pool, beautifully cared for. Every single week.',services:['Weekly pool care','Water testing','Seasonal service'],color:'pool'},
 landscape:{name:'Stone & Stream',brand:'FORM / FIELD',kind:'Landscaping',tag:'MADE FOR THE WAY YOU LIVE',title:'Grounded in growth.',description:'Outdoor spaces that feel like they have always belonged.',services:['Landscape design','Planting and upkeep','Outdoor improvements'],color:'landscape'}
};
export function getStaticPaths(){
  if(site.template==='client')return [];
  return ['exterior','pool','landscape'].map(slug=>({params:{slug}}));
}
const {slug}=Astro.params;
const concept=concepts[slug];
const page={slug:'showcase/'+slug,title:concept.name+' | EZERWRIGHT fictional design concept',description:'Interactive fictional '+concept.kind+' website study created by EZERWRIGHT. Not commissioned client work.'};
---
<Layout page={page}>
  <div class:list={['concept','concept--'+slug]}>
    <div class="demo-ribbon"><div class="container"><span>EZERWRIGHT ORIGINAL DESIGN STUDY</span><strong>FICTIONAL BUSINESS — NOT CLIENT WORK</strong><a href="/#cinema-work">← All concepts</a></div></div>
    <div class="concept-dark">
      <div class="container">
        <div class="concept-nav"><strong>{concept.brand}</strong><span>SERVICES / ABOUT / CONTACT</span><a href="#example-enquiry">START AN ENQUIRY ↗</a></div>
        <div class="concept-hero">
          <div class="concept-intro">
            <p class="concept-kicker">01 / {concept.tag}</p>
            <h1>{concept.title}</h1>
            <p>{concept.description}</p>
            <a href="#example-enquiry" class="concept-btn">Explore services <span aria-hidden="true">↗</span></a>
          </div>
          <div class="concept-art" aria-hidden="true"><div class="concept-orbit orbit-a"></div><div class="concept-orbit orbit-b"></div><div class="concept-orbit orbit-c"></div><div class="concept-disc"></div><span class="concept-art-label">MOTION / MATERIAL / MEANING</span></div>
        </div>
        <div class="concept-bottom"><span>{concept.kind.toUpperCase()}</span><span>SCROLL TO EXPLORE ↓</span></div>
      </div>
    </div>
    <section class="concept-services" aria-labelledby="concept-services-heading">
      <div class="container"><p class="concept-section-label">01 / THE SERVICE</p><div class="services-head"><h2 id="concept-services-heading">Beautifully simple.<br/><em>Built around people.</em></h2><p>Not simply a striking first screen. A useful service website should help someone understand the work, find the right service, and take the next step.</p></div>
        <div class="concept-cards">{concept.services.map((item,i)=><div class="concept-card"><span>0{i+1}</span><h3>{item}</h3><p>{i===0?'Understand the service at a glance.':i===1?'See the options without unnecessary friction.':'Make it easy to get in touch.'}</p></div>)}</div>
      </div>
    </section>
    <section class="concept-journey" id="example-enquiry" aria-labelledby="concept-journey-heading"><div class="container journey-grid"><div><p class="concept-section-label">02 / INTERACTIVE EXAMPLE</p><h2 id="concept-journey-heading">An enquiry with a little more intention.</h2><p>Choose a service to explore a sample customer journey. This does not quote prices, collect personal information or send an enquiry.</p></div>
      <div class="journey-panel" data-demo-estimator><span class="journey-label">FICTIONAL / INTERACTIVE EXAMPLE</span><h3>What are you looking for?</h3><div class="demo-buttons" role="group" aria-label="Choose an example service">{concept.services.map((service,i)=><button type="button" data-option={service} aria-pressed={i===0?'true':'false'}><span>{service}</span><span aria-hidden="true">↗</span></button>)}</div><div class="journey-answer"><small>SELECTED SERVICE</small><output data-selected-service>{concept.services[0]}</output><p>For a real project, the next step could be a short, privacy-conscious request form.</p></div><small>DEMO ONLY — NO DATA TRANSMITTED</small></div>
    </div></section>
    <section class="concept-final"><div class="container"><p>DESIGNED BY EZERWRIGHT</p><h2>Imagine what we could make for your business.</h2><p>This is an original fictional concept, not a client commission. Our standard five-page website is US$500; enhanced motion and custom interactions may require separate scope.</p><div class="final-actions"><a href="/contact/?service=website" class="concept-btn">Discuss your website ↗</a><a href="/services/">See the package →</a></div></div></section>
  </div>
</Layout>
<script>
document.querySelectorAll('[data-demo-estimator]').forEach(panel=>{
 const output=panel.querySelector('[data-selected-service]');
 const buttons=panel.querySelectorAll('button[data-option]');
 buttons.forEach(button=>button.addEventListener('click',()=>{
  buttons.forEach(other=>other.setAttribute('aria-pressed',String(other===button)));
  if(output)output.textContent=button.dataset.option||'';
 }));
});
</script>
<style is:global>
.concept{--highlight:#d8ff62;--back:#101e3d;--paper:#f4f3e8;color:#23473a}.concept--pool{--highlight:#a8f4e9;--back:#063c50;--paper:#e9f6f1}.concept--landscape{--highlight:#e6c48d;--back:#244234;--paper:#eee9d8}
.demo-ribbon{background:#e6eee7;color:#345c4a}.demo-ribbon>.container{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:10px 0;font-size:9px;letter-spacing:.1em}.demo-ribbon a{color:#2b5f49;text-decoration:none}
.concept-dark{position:relative;overflow:hidden;background:radial-gradient(circle at 75% 35%,#ffffff16,transparent 40%),var(--back);color:white}.concept-dark:before{content:"";position:absolute;inset:0;opacity:.16;background:linear-gradient(90deg,#d5fff12a 1px,transparent 1px),linear-gradient(#d5fff12a 1px,transparent 1px);background-size:72px 72px;pointer-events:none}.concept-nav,.concept-hero,.concept-bottom{position:relative}
.concept-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:96px}.concept-nav strong{font:850 22px Manrope,sans-serif;letter-spacing:-.06em}.concept-nav>span{font-size:9px;letter-spacing:.14em}.concept-nav a{font-size:10px;border:1px solid #ffffff83;padding:12px;color:white;text-decoration:none}
.concept-hero{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:center;min-height:620px}.concept-intro{position:relative;z-index:2}.concept-kicker,.concept-section-label{font-size:10px;letter-spacing:.2em;color:var(--highlight);font-weight:800}.concept-intro h1{font:850 clamp(3.5rem,7vw,7.2rem)/.97 Manrope,sans-serif;letter-spacing:-.09em;color:white;margin:25px 0}.concept-intro>p:nth-of-type(2){font-size:17px;line-height:1.6;color:#d7e8df;max-width:400px}
.concept-btn{display:inline-flex;justify-content:space-between;gap:35px;padding:16px 20px;min-height:52px;align-items:center;background:var(--highlight);color:#152f27;font-weight:800;text-decoration:none;font-size:14px;border-radius:3px}
.concept-art{position:relative;height:520px;isolation:isolate}.concept-art:before{content:"";position:absolute;inset:14%;background:var(--highlight);opacity:.3;filter:blur(75px);border-radius:50%;z-index:-1}.concept-orbit{position:absolute;width:380px;height:380px;left:calc(50% - 190px);top:calc(50% - 190px);border:1px solid var(--highlight);border-radius:50%;transform:rotateX(60deg) rotateZ(25deg);opacity:.6;animation:orbit-sway 9s ease-in-out infinite alternate}.orbit-b{width:470px;height:470px;left:calc(50% - 235px);top:calc(50% - 235px);opacity:.35}.orbit-c{width:540px;height:540px;left:calc(50% - 270px);top:calc(50% - 270px);opacity:.18}.concept-disc{position:absolute;left:calc(50% - 115px);top:calc(50% - 115px);width:230px;height:230px;border:38px solid var(--highlight);border-radius:50%;box-shadow:0 0 70px #ffffff56;transform:rotateX(35deg);animation:disc-float 7s ease-in-out infinite alternate}.concept--landscape .concept-disc{border-radius:40% 60% 50% 45%;transform:rotate(20deg)}.concept-art-label{position:absolute;right:0;bottom:10%;font-size:9px;letter-spacing:.14em}.concept-bottom{display:flex;justify-content:space-between;gap:15px;padding:20px 0;border-top:1px solid #ffffff50;font-size:10px;letter-spacing:.14em;color:#cfebe0}
.concept-services{background:var(--paper);padding:100px 0}.concept-services .concept-section-label,.concept-journey .concept-section-label{color:#4f7869}.services-head,.journey-grid{display:grid;grid-template-columns:1fr .7fr;gap:45px;align-items:end}.concept h2{font:750 clamp(2.5rem,5vw,4.6rem)/1.05 Manrope,sans-serif;letter-spacing:-.07em;color:#234938}.services-head h2 em{color:#59917b;font:italic 500 1em Georgia,serif}.services-head p,.journey-grid>div:first-child>p:last-child{font-size:15px;color:#627c6c;line-height:1.75}
.concept-cards{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #9bbaa7;margin-top:40px}.concept-card{padding:25px 22px;border-right:1px solid #9bbaa7}.concept-card:last-child{border:0}.concept-card>span{font-size:11px;color:#59846e}.concept-card h3{font:800 22px Manrope,sans-serif;color:#285340;margin-top:35px;letter-spacing:-.04em}.concept-card p{font-size:14px;color:#6c8072}
.concept-journey{background:#dcebe2;padding:100px 0}.journey-grid{grid-template-columns:.8fr 1fr;align-items:center}.journey-panel{background:white;padding:30px;border-radius:6px;box-shadow:0 20px 60px #294a3430}.journey-label,.journey-panel>small{font-size:10px;letter-spacing:.14em;color:#688475}.journey-panel h3{color:#224f3a;letter-spacing:-.04em}.demo-buttons{display:grid;gap:10px}.demo-buttons button{display:flex;justify-content:space-between;gap:15px;text-align:left;align-items:center;border:1px solid #c4d7ca;background:#f3f8f3;color:#28523b;padding:15px;font-size:14px}.demo-buttons button[aria-pressed=true]{border:2px solid #28684b;background:#e0f3e8;font-weight:800}.journey-answer{border-top:1px solid #d6e6d9;padding-top:20px;margin-top:24px}.journey-answer small{color:#527962}.journey-answer output{display:block;color:#24583b;font:800 22px Manrope,sans-serif;margin:10px 0}.journey-answer p{font-size:12px;color:#6d806f}
.concept-final{background:#0c2029;text-align:center;padding:100px 0;color:#cce0d7}.concept-final h2{color:#fff;max-width:750px;margin:25px auto}.concept-final p{max-width:670px;margin:20px auto;color:#b8cdc1}.concept-final p:first-child{font-size:10px;letter-spacing:.15em;color:#9fe0be}.final-actions{display:flex;justify-content:center;align-items:center;gap:22px;flex-wrap:wrap}.final-actions>a:last-child{color:white;font-size:14px;font-weight:800}
@keyframes orbit-sway{to{transform:rotateX(62deg) rotateZ(40deg)}}@keyframes disc-float{to{transform:translateY(-18px) rotateX(35deg)}}
@media(max-width:900px){.concept-hero{grid-template-columns:1fr;min-height:auto}.concept-art{height:390px}.concept-nav>span{display:none}.services-head,.journey-grid{grid-template-columns:1fr}}
@media(max-width:620px){.concept-nav strong{font-size:16px}.concept-nav a{font-size:9px}.concept-intro h1{font-size:clamp(3.3rem,11vw,5rem)}.concept-art{height:260px;transform:scale(.67);width:140%;transform-origin:15% 40%;margin-bottom:-55px}.concept-services,.concept-journey,.concept-final{padding:70px 0}.concept-cards{grid-template-columns:1fr}.concept-card{border-right:0;border-bottom:1px solid #9bbaa7;padding:18px 0}.concept-card h3{margin-top:18px}.journey-panel{padding:20px}}
@media(prefers-reduced-motion:reduce){.concept-orbit,.concept-disc{animation:none!important}}
</style>