---
import Layout from '../../layouts/Layout.astro';
import {site} from '../../config/site.mjs';
const concepts = {
 exterior:{name:'Rinse & Rise',brand:'VOLT / WASH',kind:'Exterior cleaning',tag:'ENERGY IN EVERY DETAIL',title:'Pure impact. No compromise.',description:'For beautiful homes and the spaces that surround them.',services:['House exteriors','Driveways and patios','Commercial cleaning'],color:'exterior'},
 pool:{name:'Blue Hour',brand:'LUMA / POOLS',kind:'Pool care',tag:'THE ART OF CLEAR WATER',title:'A little more blue.',description:'Your pool, beautifully cared for. Every single week.',services:['Weekly pool care','Water testing','Seasonal service'],color:'pool'},
 landscape:{name:'Stone & Stream',brand:'FORM / FIELD',kind:'Landscaping',tag:'MADE FOR THE WAY YOU LIVE',title:'Grounded in growth.',description:'Outdoor spaces that feel like they have always belonged.',services:['Landscape design','Planting and upkeep','Outdoor improvements'],color:'landscape'}
};
export function getStaticPaths(){
  if(site.template==='client')return [];
  return ['exterior','pool','landscape'].map(slug=>({params:{slug}}));
}
const {slug}=Astro.params;
const concept=concepts[slug];
const page={slug:'showcase/'+slug,title:concept.name+' | EZERWRIGHT fictional design concept',description:'Interactive fictional '+concept.kind+' website study created by EZERWRIGHT. Not commissioned client work.'};
---
<Layout page={page}>
  <div class:list={['concept','concept--'+slug]}>
    <div class="demo-ribbon"><div class="container"><span>EZERWRIGHT ORIGINAL DESIGN STUDY</span><strong>FICTIONAL BUSINESS — NOT CLIENT WORK</strong><a href="/#cinema-work">← All concepts</a></div></div>
    <div class="concept-dark">
      <div class="container">
        <div class="concept-nav"><strong>{concept.brand}</strong><span>SERVICES / ABOUT / CONTACT</span><a href="#example-enquiry">START AN ENQUIRY ↗</a></div>
        <div class="concept-hero">
          <div class="concept-intro">
            <p class="concept-kicker">01 / {concept.tag}</p>
            <h1>{concept.title}</h1>
            <p>{concept.description}</p>
            <a href="#example-enquiry" class="concept-btn">Explore services <span aria-hidden="true">↗</span></a>
          </div>
          <div class="concept-art" aria-hidden="true"><div class="concept-orbit orbit-a"></div><div class="concept-orbit orbit-b"></div><div class="concept-orbit orbit-c"></div><div class="concept-disc"></div><span class="concept-art-label">MOTION / MATERIAL / MEANING</span></div>
        </div>
        <div class="concept-bottom"><span>{concept.kind.toUpperCase()}</span><span>SCROLL TO EXPLORE ↓</span></div>
      </div>
    </div>
    <section class="concept-services" aria-labelledby="concept-services-heading">
      <div class="container"><p class="concept-section-label">01 / THE SERVICE</p><div class="services-head"><h2 id="concept-services-heading">Beautifully simple.<br/><em>Built around people.</em></h2><p>Not simply a striking first screen. A useful service website should help someone understand the work, find the right service, and take the next step.</p></div>
        <div class="concept-cards">{concept.services.map((item,i)=><div class="concept-card"><span>0{i+1}</span><h3>{item}</h3><p>{i===0?'Understand the service at a glance.':i===1?'See the options without unnecessary friction.':'Make it easy to get in touch.'}</p></div>)}</div>
      </div>
    </section>
    <section class="concept-journey" id="example-enquiry" aria-labelledby="concept-journey-heading"><div class="container journey-grid"><div><p class="concept-section-label">02 / INTERACTIVE EXAMPLE</p><h2 id="concept-journey-heading">An enquiry with a little more intention.</h2><p>Choose a service to explore a sample customer journey. This does not quote prices, collect personal information or send an enquiry.</p></div>
      <div class="journey-panel" data-demo-estimator><span class="journey-label">FICTIONAL / INTERACTIVE EXAMPLE</span><h3>What are you looking for?</h3><div class="demo-buttons" role="group" aria-label="Choose an example service">{concept.services.map((service,i)=><button type="button" data-option={service} aria-pressed={i===0?'true':'false'}><span>{service}</span><span aria-hidden="true">↗</span></button>)}</div><div class="journey-answer"><small>SELECTED SERVICE</small><output data-selected-service>{concept.services[0]}</output><p>For a real project, the next step could be a short, privacy-conscious request form.</p></div><small>DEMO ONLY — NO DATA TRANSMITTED</small></div>
    </div></section>
    <section class="concept-final"><div class="container"><p>DESIGNED BY EZERWRIGHT</p><h2>Imagine what we could make for your business.</h2><p>This is an original fictional concept, not a client commission. Our standard five-page website is US$500; enhanced motion and custom interactions may require separate scope.</p><div class="final-actions"><a href="/contact/?service=website" class="concept-btn">Discuss your website ↗</a><a href="/services/">See the package →</a></div></div></section>
  </div>
</Layout>
<script>
document.querySelectorAll('[data-demo-estimator]').forEach(panel=>{
 const output=panel.querySelector('[data-selected-service]');
 const buttons=panel.querySelectorAll('button[data-option]');
 buttons.forEach(button=>button.addEventListener('click',()=>{
  buttons.forEach(other=>other.setAttribute('aria-pressed',String(other===button)));
  if(output)output.textContent=button.dataset.option||'';
 }));
});
</script>
<style>
.concept{--highlight:#d8ff62;--back:#0c1d38;--paper:#f5f4e9;color:#203e34}.concept--pool{--highlight:#b3fbec;--back:#07374b;--paper:#eaf8f3}.concept--landscape{--highlight:#e5c58a;--back:#203c30;--paper:#f2edda}.concept *{box-sizing:border-box}
.demo-ribbon{background:#e8efe9;color:#38534b}.demo-ribbon>.container{display:flex;justify-content:space-between;gap:12px;align-items:center;padding-block:11px;font-size:9px;letter-spacing:.1em}.demo-ribbon a{color:#315f4d;text-decoration:none}.concept-dark{color:white;background:radial-gradient(circle at 77% 43%,#ffffff13,transparent 38%),var(--back);position:relative;overflow:hidden}.concept-dark:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.16;background-image:linear-gradient(#c3f8ed44 1px,transparent 1px),linear-gradient(90deg,#c3f8ed44 1px,transparent 1px);background-size:74px 74px;mask-image:linear-gradient(#000,transparent)}.concept-nav{min-height:96px;display:flex;justify-content:space-between;align-items:center;gap:16px;position:relative;z-index:2}.concept-nav strong{font:800 23px Manrope,system-ui,sans-serif;letter-spacing:-.06em}.concept-nav>span{font-size:10px;letter-spacing:.2em}.concept-nav a{border:1px solid #ffffff7a;padding:12px 14px;color:white;font-size:10px;text-decoration:none;font-weight:750}.concept-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:20px;min-height:610px;position:relative}.concept-intro{position:relative;z-index:3}.concept-kicker,.concept-section-label{font-size:11px;letter-spacing:.2em;font-weight:750;color:var(--highlight)}.concept-intro h1{font-family:Manrope,sans-serif;font-size:clamp(3.5rem,7vw,7.4rem);line-height:.96;letter-spacing:-.09em;color:#f3faf7;margin:26px 0}.concept-intro>p:nth-of-type(2){font-size:18px;line-height:1.6;max-width:400px;color:#d6e8e1}.concept-btn{display:inline-flex;gap:36px;align-items:center;justify-content:space-between;background:var(--highlight);color:#153126;text-decoration:none;font-weight:800;font-size:14px;min-height:54px;padding:16px 20px;border-radius:3px}.concept-btn:hover{filter:brightness(1.08)}
.concept-art{height:530px;position:relative;isolation:isolate}.concept-art:before{content:"";position:absolute;inset:5%;border-radius:50%;filter:blur(38px);background:radial-gradient(circle,var(--highlight),transparent 65%);opacity:.35;z-index:-1}.concept-orbit{position:absolute;border:1px solid var(--highlight);border-radius:50%;width:380px;height:380px;left:calc(50% - 190px);top:calc(50% - 190px);transform:rotateX(61deg) rotateZ(21deg);opacity:.6;animation:orbit 12s ease-in-out infinite alternate}.orbit-b{width:480px;height:480px;left:calc(50% - 240px);top:calc(50% - 240px);opacity:.35;animation-duration:9s}.orbit-c{width:550px;height:550px;left:calc(50% - 275px);top:calc(50% - 275px);opacity:.15;animation-duration:14s}.concept-disc{position:absolute;width:240px;height:240px;left:calc(50% - 120px);top:calc(50% - 120px);border:40px solid var(--highlight);border-radius:50%;box-shadow:0 0 90px #ffffff3b,inset 0 0 50px #ffffff3b;transform:rotateX(36deg);animation:float 7s ease-in-out infinite alternate}.concept--landscape .concept-disc{border-radius:40% 60% 50% 40%;transform:rotate(26deg)}.concept-art-label{position:absolute;bottom:12%;right:0;font-size:9px;letter-spacing:.18em;color:#e3f3e9}.concept-bottom{display:flex;justify-content:space-between;border-top:1px solid #ffffff65;padding:22px 0;color:#cbded4;font-size:10px;letter-spacing:.15em;font-weight:700}
.concept-services{background:var(--paper);padding:95px 0}.concept-services .concept-section-label,.concept-journey .concept-section-label{color:#5a816f}.services-head{display:grid;grid-template-columns:1fr .7fr;gap:35px;align-items:end}.concept h2{font-family:Manrope,sans-serif;letter-spacing:-.065em;line-height:1.05;font-size:clamp(2.5rem,5vw,4.6rem);color:#25443b}.services-head h2 em{font-family:Georgia,serif;font-weight:400;color:#568671}.services-head p{color:#5e756b;font-size:15px;line-height:1.75}.concept-cards{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #9db7a7;margin-top:40px}.concept-card{padding:27px 25px;border-right:1px solid #9db7a7}.concept-card:last-child{border:0}.concept-card>span{font-size:11px;color:#5c8474}.concept-card h3{margin-top:38px;color:#214436;font-family:Manrope,sans-serif;letter-spacing:-.05em}.concept-card p{font-size:14px;color:#668173}
.concept-journey{background:#dce9df;padding:95px 0}.journey-grid{display:grid;grid-template-columns:.82fr 1fr;gap:70px;align-items:center}.journey-grid>div:first-child>p:last-child{font-size:16px;color:#536c61;line-height:1.75}.journey-panel{background:white;padding:30px;border-radius:7px;box-shadow:0 24px 65px #274e3830}.journey-label,.journey-panel>small{font-size:10px;color:#65806e;letter-spacing:.13em}.journey-panel h3{font-family:Manrope,sans-serif;letter-spacing:-.04em;color:#1f4c3d;margin:25px 0}.demo-buttons{display:grid;gap:9px}.demo-buttons button{display:flex;justify-content:space-between;align-items:center;gap:8px;text-align:left;padding:15px;border:1px solid #c5d8ca;color:#244636;background:#f4f8f4;border-radius:4px;font-size:14px}.demo-buttons button[aria-pressed=true]{border:2px solid #27634d;background:#dcf4e5;font-weight:700}.journey-answer{border-top:1px solid #d6e3d9;margin-top:26px;padding-top:18px}.journey-answer small{font-size:9px;letter-spacing:.1em;color:#4a745d}.journey-answer output{display:block;font-size:22px;font-weight:800;font-family:Manrope,sans-serif;margin:8px 0;color:#1f5b43}.journey-answer p{color:#657769;font-size:12px;line-height:1.65}
.concept-final{background:#0b1e25;padding:95px 0;text-align:center;color:#d3e6da}.concept-final h2{color:#fff;max-width:790px;margin:20px auto}.concept-final p{max-width:650px;margin:20px auto;font-size:15px;color:#b5cdc1}.concept-final p:first-child{font-size:10px;letter-spacing:.18em;color:#a2edc7}.final-actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:20px}.final-actions>a:last-child{color:#deefe6;font-size:14px;font-weight:750}
@keyframes float{to{transform:translateY(-17px) rotateX(33deg)}}@keyframes orbit{to{transform:rotateX(65deg) rotateZ(39deg)}}@media(max-width:900px){.concept-hero{grid-template-columns:1fr}.concept-art{height:390px}.concept-nav>span{display:none}.journey-grid{gap:28px}}@media(max-width:640px){.demo-ribbon>.container{flex-wrap:wrap}.concept-nav strong{font-size:16px}.concept-nav a{font-size:9px}.concept-hero{min-height:auto}.concept-intro h1{font-size:clamp(3.25rem,11vw,5rem)}.concept-art{height:270px;transform:scale(.72);transform-origin:20% 40%;width:135%;margin-bottom:-40px}.services-head,.journey-grid{grid-template-columns:1fr}.concept-services,.concept-journey,.concept-final{padding:68px 0}.concept-cards{grid-template-columns:1fr}.concept-card{padding:24px 0;border-right:0;border-bottom:1px solid #9db7a7}.concept-card h3{margin-top:18px}.journey-panel{padding:20px}.concept-bottom{font-size:8px}}@media(prefers-reduced-motion:reduce){.concept-orbit,.concept-disc{animation:none!important}}
</style>