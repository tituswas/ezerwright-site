---
import Layout from '../layouts/Layout.astro';
const page={slug:'404',title:'Page not found',description:'This page is not part of the website. Return to the home page or contact route.'};
---
<Layout page={page}><section class="container page-intro"><p class="eyebrow">404</p><h1>Let’s get you<br/>back on track.</h1><p>The page could not be found.</p><a class="button" href="/">Return home</a></section></Layout>
