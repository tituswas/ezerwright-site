---
import {site} from '../config/site.mjs';
import {offer} from '../config/offer.mjs';
import Layout from '../layouts/Layout.astro';
import CinematicExperience from '../components/CinematicExperience.astro';
import InteriorOpening from '../components/InteriorOpening.astro';
import '../styles/agency-interiors.css';
import Card from '../components/Card.astro';
import CTA from '../components/CTA.astro';
import ContactForm from '../components/ContactForm.astro';
import ContentSections from '../components/ContentSections.astro';
export function getStaticPaths(){return site.pages.map(page=>({params:{page:page.slug||undefined},props:{page}}));}
const {page}=Astro.props;
---
<Layout page={page}>
<div class:list={['page-frame',{'agency-interior':site.template!=='client'&&page.slug!==''}]}>
{site.template==='client'&&!['contact','privacy'].includes(page.slug)&&<><section class="container page-intro"><p class="eyebrow">{page.label||page.title}</p><h1>{page.heading||page.title}</h1><p>{page.intro||page.description}</p></section><ContentSections sections={page.sections}/><CTA title={site.hero.primary} text={site.hero.description}/></>}
{site.template!=='client'&&page.slug==='' && <>
<CinematicExperience/>

</>}
{site.template!=='client'&&page.slug==='services' && <><InteriorOpening variant="services" eyebrow="01 / A BETTER FIRST IMPRESSION" first="A website with" accent="presence." description="You bring the business. We build a distinctive digital foundation with a clear path from first impression to first enquiry."/><section class="container offer-grid"><div class="offer-card"><p class="eyebrow">The initial website offer</p><h2 class="price"><span>US$</span>{offer.totalUSD}</h2><p>One business. One location. Up to five marketing pages.</p><div class="payment-split"><span><strong>$250</strong> to begin after scope approval</span><span><strong>$250</strong> after explicit staging acceptance</span></div><a class="button" href="/contact/?service=website">Discuss the website <span aria-hidden="true">↗</span></a></div><div class="scope-copy"><h2>Clear from the start.</h2><ul class="check-list"><li>Responsive pages with a practical contact form</li><li>Two consolidated revision rounds</li><li>Basic page titles, descriptions and sitemap</li><li>Client-owned, portable source and hosting</li><li>Short client-approved privacy utility page</li></ul><p>First complete staging review: five business days after cleared deposit and complete intake/access. Balance clears before handover or deployment. Includes a 14-day defect window.</p><a class="text-link" href="/approach/">How the project works →</a></div></section><section class="container section"><div class="section-heading"><h2>Capabilities for later.</h2><p>These are separately scoped projects, not additions hidden inside the $500 website.</p></div><div class="card-grid">{site.services.map(s=><Card title={s.title} description={s.summary} detail={s.detail}/>)}</div></section><section class="container section narrow"><p class="eyebrow">Before we start</p><h2>Questions, answered.</h2><div class="faq">{site.faq.map(f=><details><summary>{f.question}<span aria-hidden="true">＋</span></summary><p>{f.answer}</p></details>)}</div><p class="small-copy">Scope limits: 1,500 words, eight services, twelve authorized images, one design direction; up to ten specific in-scope edits per revision round. Defects do not consume rounds. Third-party services require approval. Ecommerce, custom apps, ongoing SEO and legal drafting are excluded.</p></section><CTA/></>}
{site.template!=='client'&&page.slug==='approach' && <><InteriorOpening variant="approach" eyebrow="02 / THE WORK BEHIND THE WOW" first="Clear process." accent="Confident delivery." description={site.approach.intro}/><section class="container section top-tight"><h2>Four clear stages.</h2><div class="process-grid">{site.approach.steps.map((s,i)=><Card number={`0${i+1}`} title={s.title} description={s.text}/>)}</div></section><section class="surface-section"><div class="container living-grid"><div><p class="eyebrow">Ownership matters</p><h2>Your site.<br/>Your next move.</h2><p>Receive the source, deployable files, asset licenses and an update/rollback guide. Your domain and hosting stay under your control.</p></div><div class="ownership-panel"><h3>At handover</h3><ul class="check-list"><li>Explicit acceptance of the final staging version</li><li>Cleared final balance before delivery</li><li>Client-approved release and a tested contact route</li><li>A defined fourteen-day defect window</li></ul></div></div></section><section class="container section narrow"><h2>Keep the website useful.</h2><p>Update services and offers as the business changes. Improve the contact path based on real feedback. Add integrations when they earn their place. Ongoing work is separately agreed.</p><p>Thoughtful hover, focus and feedback states make the site feel responsive. Motion respects accessibility preferences; it never hides useful content.</p></section><CTA title="A useful next step starts with clarity."/></>}
{site.template!=='client'&&page.slug==='living'&&<>
<InteriorOpening variant="living" eyebrow="03 / WEBSITES THAT EVOLVE" first="Made to work." accent="Made to grow." description="An unmistakable first impression matters. So do useful updates, simple enquiries, ownership and a website that stays relevant."/>
<section class="container section top-tight"><div class="section-heading"><h2>Three kinds of useful.</h2><p>Not visual effects for their own sake. Practical foundations businesses can keep using.</p></div><div class="card-grid">
<Card number="01" title="Clear enquiries" description="A direct next step, consistent calls to action and a contact form with real delivery testing before publication."/>
<Card number="02" title="Portable ownership" description="Source files and handoff documentation, with hosting and domain access owned by the client."/>
<Card number="03" title="Thoughtful feedback" description="Legible buttons, keyboard-focus states, subtle motion that respects reduced-motion preferences and mobile layouts."/>
</div></section>
<section class="surface-section"><div class="container living-grid"><div><p class="eyebrow">Room to improve</p><h2>Keep what works. Change what needs to.</h2><p>Seasonal services, updated offers, fresh project photography and useful integrations can be addressed as separate improvements when the business needs them.</p><a class="text-link" href="/services/">See the website package →</a></div><div class="living-panel"><span class="panel-label">Included now / available later</span><ul><li><span aria-hidden="true">✓</span> Responsive website foundation</li><li><span aria-hidden="true">✓</span> Contact route and ownership</li><li><span aria-hidden="true">＋</span> Future automation and upgrades</li></ul><p>AI, analytics, integrations and ongoing optimization are not part of the initial $500 package.</p></div></div></section><CTA title="A good website should make the next step simpler."/>
</>}
{page.slug==='contact' && <>{site.template==='client'?<section class="container page-intro"><p class="eyebrow">Contact</p><h1>{page.heading||(site.template==='client'?'How can we help?':'What would you like to build?')}</h1><p>{page.intro||(site.preview?'This is a design preview. Forms are disabled here; use the live website to contact us.':site.mode==='demo'?'Try the complete enquiry flow using sample information. No email is sent.':'Share the goal and the next step you need.')}</p></section>:<InteriorOpening variant="contact" eyebrow="04 / START A CONVERSATION" first="You have the idea." accent="Let’s give it form." description={site.preview?'This is a design preview. Enquiry forms are disabled here. Visit the live website to contact us.':'Tell us what your business needs. Our first step is an email conversation about a clear, agreed scope.'}/>}<section class="container contact-grid"><div>{site.preview?<div class="contact-form"><p class="eyebrow">Design preview only</p><h2>Enquiries are disabled on this preview.</h2><p>No visitor details are collected here. To discuss a real website project, use the live EZERWRIGHT contact form.</p><a class="button" href="https://ezerwright.com/contact/">Visit the live contact page <span aria-hidden="true">↗</span></a></div>:<ContactForm/>}</div><div class="contact-aside"><h2>{page.asideTitle||'A simple first step.'}</h2><p>{page.asideText||(site.template==='client'?'Share what you need and we can discuss the next step.':'Describe what should work better. The next step is to agree the scope, not to commit to an open-ended project.')}</p><div class="contact-detail"><span>{site.mode==='demo'&&!site.preview?'Sample email fallback':'Email'}</span><a href={`mailto:${site.email}`}>{site.email}</a></div>{site.phone&&<div class="contact-detail"><span>Phone</span><a href={`tel:${site.phone.replace(/[^+\d]/g,'')}`}>{site.phone}</a></div>}<p class="small-copy">Please do not include passwords, financial details or private customer information.</p></div></section></>}
{page.slug==='privacy'&&site.mode==='production'&&<><InteriorOpening variant="privacy" eyebrow="05 / PRIVACY AND TRANSPARENCY" first="Built with care." accent="Explained clearly." description={page.description}/><ContentSections sections={site.privacySections}/></>}
{page.slug==='privacy'&&site.preview&&<><InteriorOpening variant="privacy" eyebrow="05 / DESIGN PREVIEW NOTICE" first="A safe preview." accent="Nothing to submit." description="This Cloudflare preview is for visual review only. Enquiry forms are deliberately disabled."/><section class="container section narrow top-tight"><h2>No submissions on this preview</h2><p>Contact forms are intentionally disabled. The interactive showcase selectors use only local browser state and do not store or send personal information.</p><h2>Hosting and access</h2><p>Cloudflare hosts the static preview and may process standard infrastructure requests and logs. This preview includes no advertising pixels or session-replay scripts. Please do not send private information here.</p><h2>Live enquiries</h2><p>For the operating business, use the <a href="https://ezerwright.com/contact/">live EZERWRIGHT contact page</a>, which has its own privacy information and submission protections.</p></section></>}
{page.slug==='privacy'&&site.mode==='demo'&&!site.preview && <>{site.template==='client'?<section class="container page-intro"><p class="eyebrow">Privacy</p><h1>{site.mode==='demo'?'A transparent demonstration.':'How enquiry information is used.'}</h1><p>{site.mode==='demo'?'This notice describes the local demonstration, not a launched business.':'Review the approved data-use information for this contact route.'}</p></section>:<InteriorOpening variant="privacy" eyebrow="05 / A TRANSPARENT DEMONSTRATION" first="Built with care." accent="Explained clearly." description="This private demonstration uses synthetic test details only. It is not an active commercial enquiry service."/>}<section class="container section narrow top-tight"><h2>Contact information</h2><p>The form collects a name, email, optional business name, service choice and project message. The purpose is to respond to the enquiry. No newsletter consent is bundled with it.</p><h2>Where the information goes</h2><p>{site.mode==='demo'?'Synthetic submissions are written to a local capture file on the computer running the demonstration server. No external mailbox, analytics or cloud storage receives them. The capture file is excluded from source and handoff packages. Delete it after testing.':'Enquiries go to the owner-approved mailbox through the configured delivery provider. Before launch, replace this draft with the verified controller, provider, retention and rights information.'}</p><h2>Analytics and sensitive information</h2><p>This foundation includes no advertising pixels, analytics beacon or session replay. Avoid supplying sensitive data. Application errors do not log enquiry payloads.</p><h2>Before public launch</h2><p>{site.mode==='demo'?'A verified business identity, active contact address, approved processing/retention facts, client-approved privacy text and actual delivery test are still required. This demonstration is noindex and is not publicly deployed.':'Confirm the real controller identity, processors, retention period and contact for privacy requests. This draft must be approved for the actual deployment.'}</p><a class="text-link" href="/contact/">Return to contact →</a></section></>}
</div>
</Layout>
