---
import ProjectBrief from './ProjectBrief.astro';
const projects=[
 {id:'landscape',name:'Stone & Stream',brand:'Stone & Stream',category:'Landscape design',title:'Thoughtful landscapes for everyday living.',image:'garden',services:['Landscape design','Planting & installation','Seasonal care'],description:'An outdoor space with a sense of belonging. Natural, editorial and designed around the next enquiry.'},
 {id:'pool',name:'Blue Hour',brand:'Blue Hour / Pool Care',category:'Pool care',title:'A little more stillness. A lot more blue.',image:'pool',services:['Weekly pool care','Water testing','Seasonal service'],description:'An unhurried rhythm, sunlit photography and a beautifully simple service story.'},
 {id:'exterior',name:'Rinse & Rise',brand:'Rinse & Rise',category:'Exterior care',title:'A fresh beginning, right on your doorstep.',image:'exterior',services:['House exteriors','Patios & driveways','Commercial care'],description:'A confident first impression with a clear path from the right service to a real conversation.'}
];
---
<div class="approved-home"><svg class="symbols" aria-hidden="true"><defs><symbol id="arrow" viewBox="0 0 24 24"><path d="M4 12h15M12 5l7 7-7 7"/></symbol><symbol id="diagonal" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></symbol></defs></svg>
<section class="hero"><img class="architecture" src="/art/director-architecture.webp" alt="" fetchpriority="high"><div class="hero-shade"></div><div class="hero-top"><p>Independent web design & development.<br>For businesses with something to say.</p><p class="hero-note">A stronger presence.<br>A clearer next step.</p></div><div class="hero-title"><h1>Make an <br><span>entrance.</span></h1><a class="hero-action" href="/contact/"><span>Start your<br>next chapter</span><svg><use href="#diagonal"/></svg></a></div><div class="hero-bottom"><span>Presence, with purpose.</span><a href="#work">Explore the work <svg><use href="#arrow"/></svg></a><span class="scroll-label">Scroll to discover</span></div></section>
<section class="work section" id="work"><div class="section-head"><h2>Different businesses.<br><em>Distinctive worlds.</em></h2><p>A website should feel like the business behind it. Explore three fictional studies, each with its own character.</p></div><section class="selected-work" id="cinema-work" aria-label="Interactive website design showcase">
 <div class="website-deck" data-showcase tabindex="0" role="region" aria-roledescription="carousel" aria-label="Fictional website concepts. Scroll over this panel, use arrow keys, or use the previous and next buttons." aria-describedby="showcase-help">
  {projects.map((p,i)=><article class={`website-panel website-panel--${p.id}`} data-work-panel={p.id} aria-label={`${i+1} of 3: ${p.name}`}>
   <div class="website-image"><img src={`/art/living-${p.image}.webp`} width="1536" height="1024" alt={p.id==='landscape'?'Sunlit garden with stone steps and layered planting':p.id==='pool'?'Quiet swimming pool beside a sunlit Mediterranean home':'Fresh stone courtyard and a carefully maintained house exterior'} loading="lazy"/>
    <div class="website-masthead"><strong>{p.brand}</strong><span>Services &nbsp; About &nbsp; Contact</span></div>
    <div class="website-copy"><p>{p.category.toUpperCase()}</p><h2>{p.title}</h2><a href={`/showcase/${p.id}/`}>Explore the concept <span aria-hidden="true">→</span></a></div>
   </div>
   <div class="website-disclosure"><span>{p.name}</span><span>FICTIONAL CONCEPT / 0{i+1}</span></div>
  </article>)}
 </div>
 <div class="filmstrip-footer"><p id="showcase-help" class="showcase-help">Independent ideas. <span>Fictional website studies, built to explore.</span></p><div class="work-controls"><button type="button" data-work-prev aria-label="Previous website concept">←</button><span data-work-position>01 / 03</span><button type="button" data-work-next aria-label="Next website concept">→</button></div></div>
 <p class="sr-only" aria-live="polite" aria-atomic="true" data-work-status>Stone &amp; Stream concept selected. 1 of 3.</p>
</section>
</section>
<section class="approach section" id="approach"><div class="approach-intro"><h2 data-reveal>Good design gets attention.<br><span>Great design gives it purpose.</span></h2><div><p>Your business has its own story. We help it find the right expression online, with considered design and a clear path from first impression to first enquiry.</p><a class="text-link" href="/approach/">A look at our approach <svg><use href="#diagonal"/></svg></a></div></div><div class="process"><article><span>Listen</span><h3>Start with<br>your business.</h3><p>The people you serve. The work you do. The next move that matters.</p></article><article><span>Design</span><h3>Make it feel<br>like you.</h3><p>A distinctive visual direction, thoughtful typography and space for your story.</p></article><article><span>Build</span><h3>Make it work<br>beautifully.</h3><p>Responsive pages, a working enquiry route and portable source you own.</p></article></div></section>
<section class="scope section" id="scope"><div class="scope-intro"><h2>A clear scope.<br>A considered start.</h2><p>A defined five-page website for your business. We agree the details in writing and handle the project by email.</p><a class="text-link" href="/services/">See the complete scope <svg><use href="#diagonal"/></svg></a></div><div class="price-panel"><div class="price-heading"><h3>Defined<br>website build</h3><p class="price"><span>US$</span><strong>500</strong></p></div><ul><li>Up to five marketing pages</li><li>Two consolidated revision rounds</li><li>Responsive design and enquiry route</li><li>Client-owned, portable source</li></ul><div class="payment"><p><strong>US$250</strong><span>After approved scope</span></p><p><strong>US$250</strong><span>After accepted staging</span></p></div><a class="button" href="/contact/">Tell us about your project <svg><use href="#diagonal"/></svg></a></div></section>
<section class="additional-work section"><div><h2>Beyond the website.</h2><p>Useful connections and carefully scoped next steps.</p></div><a href="/plugins/"><strong>Plugins & integrations</strong><span>Catalog in preparation. Integration work is separately scoped.</span><svg><use href="#diagonal"/></svg></a><a href="/audits/"><strong>AI-app security reviews</strong><span>Coming soon. In development. No audit bookings yet.</span><svg><use href="#diagonal"/></svg></a></section><section class="brief-section section"><ProjectBrief/></section><section class="contact section"><div class="contact-line"><span>Have something in mind?</span><span>Start by email. No call required.</span></div><a class="contact-title" href="/contact/"><h2>Let’s make<br><em>your next move.</em></h2><svg><use href="#diagonal"/></svg></a></section></div>
