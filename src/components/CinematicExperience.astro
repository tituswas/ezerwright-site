---
import ProjectBrief from './ProjectBrief.astro';
const projects=[
 {id:'landscape',name:'Stone & Stream',brand:'Stone & Stream',category:'Landscape design',title:'Thoughtful landscapes for everyday living.',image:'garden',services:['Landscape design','Planting & installation','Seasonal care'],description:'An outdoor space with a sense of belonging. Natural, editorial and designed around the next enquiry.'},
 {id:'pool',name:'Blue Hour',brand:'Blue Hour / Pool Care',category:'Pool care',title:'A little more stillness. A lot more blue.',image:'pool',services:['Weekly pool care','Water testing','Seasonal service'],description:'An unhurried rhythm, sunlit photography and a beautifully simple service story.'},
 {id:'exterior',name:'Rinse & Rise',brand:'Rinse & Rise',category:'Exterior care',title:'A fresh beginning, right on your doorstep.',image:'exterior',services:['House exteriors','Patios & driveways','Commercial care'],description:'A confident first impression with a clear path from the right service to a real conversation.'}
];
---
<div class="director-studio">
<section class="studio-hero" aria-labelledby="cinema-heading">
 <img class="director-architecture" src="/art/director-architecture.webp" width="1600" height="900" fetchpriority="high" alt=""/>
 <div class="studio-hero-copy"><span class="director-mark" aria-hidden="true"></span><p class="studio-lead">Independent web design and<br class="desktop-break"/> development for small businesses.</p><a class="living-button" data-room-open href="/contact/">Start your project <span aria-hidden="true">→</span></a></div>
 <h1 id="cinema-heading"><span>Make an </span><span>entrance.</span></h1>
</section>
<section class="selected-work" id="cinema-work" aria-label="Interactive website design showcase">
 <div class="website-deck" data-showcase tabindex="0" role="region" aria-roledescription="carousel" aria-label="Fictional website concepts. Scroll over this panel, use arrow keys, or use the previous and next buttons." aria-describedby="showcase-help">
  {projects.map((p,i)=><article class={`website-panel website-panel--${p.id}`} data-work-panel={p.id} aria-label={`${i+1} of 3: ${p.name}`}>
   <div class="website-image"><img src={`/art/living-${p.image}.webp`} width="1536" height="1024" alt={p.id==='landscape'?'Sunlit garden with stone steps and layered planting':p.id==='pool'?'Quiet swimming pool beside a sunlit Mediterranean home':'Fresh stone courtyard and a carefully maintained house exterior'} loading="lazy"/>
    <div class="website-masthead"><strong>{p.brand}</strong><span>Services &nbsp; About &nbsp; Contact</span></div>
    <div class="website-copy"><p>{p.category.toUpperCase()}</p><h2>{p.title}</h2><a href={`/showcase/${p.id}/`}>Explore the concept <span aria-hidden="true">→</span></a></div>
   </div>
   <div class="website-disclosure"><span>{p.name}</span><span>FICTIONAL CONCEPT / 0{i+1}</span></div>
  </article>)}
 </div>
 <div class="filmstrip-footer"><p id="showcase-help" class="showcase-help">Independent ideas. <span>Fictional website studies, built to explore.</span></p><div class="work-controls"><button type="button" data-work-prev aria-label="Previous website concept">←</button><span data-work-position>01 / 03</span><button type="button" data-work-next aria-label="Next website concept">→</button></div></div>
 <p class="sr-only" aria-live="polite" aria-atomic="true" data-work-status>Stone &amp; Stream concept selected. 1 of 3.</p>
</section>
<section class="studio-statement" id="studio-about" aria-labelledby="studio-title"><div class="studio-section-line"><span>THE STUDIO / A CONSIDERED APPROACH</span><span>01</span></div><div class="studio-statement-grid"><h2 id="studio-title" data-reveal>From a first thought<br/>to a <em>first impression.</em></h2><div><p>Every business has something worth paying attention to. We find it, give it a visual language, and build a website that helps people take the next step.</p><a class="studio-link" href="/approach/">Meet the process <span aria-hidden="true">↗</span></a></div></div><div class="studio-principles"><article><span>01 / LISTEN</span><h3>Start with your business.</h3><p>The people you serve. The work you do. The next move that matters.</p></article><article><span>02 / DESIGN</span><h3>Make it feel like you.</h3><p>A distinctive direction, considered typography and space to breathe.</p></article><article><span>03 / BUILD</span><h3>Make it work beautifully.</h3><p>Responsive pages, a real enquiry route and portable source you own.</p></article></div></section>
<section class="studio-offering" aria-labelledby="studio-offer-title"><div class="studio-section-line"><span>A CLEAR STARTING POINT</span><span>03</span></div><div class="studio-offer-grid"><div><h2 id="studio-offer-title">Considered design.<br/><em>Clearly defined.</em></h2><p>A five-page website for your business. A real scope, a working enquiry route and a handover that keeps you in control.</p><a class="studio-link" href="/services/">Explore the full scope <span aria-hidden="true">↗</span></a></div><div class="studio-price"><span>THE DEFINED WEBSITE BUILD</span><p>US$<strong>500</strong></p><span>$250 to start after written approval.<br/>$250 after accepted staging.</span><ul><li>Up to five marketing pages</li><li>Two consolidated revision rounds</li><li>Client-owned, portable source</li></ul></div></div><div class="studio-future"><span>ON THE HORIZON</span><p>AI-app source-code security reviews.<br/><small>In development. No audit bookings yet.</small></p><a href="/audits/">Explore the direction <span aria-hidden="true">↗</span></a></div></section>
<section class="studio-enquiry" aria-labelledby="studio-enquiry-title"><div><p class="studio-overline">SOMETHING IN MIND?</p><h2 id="studio-enquiry-title">Your next chapter<br/><em>starts here.</em></h2><p>A new website, a clearer experience,<br/>or a considered next step.</p><a class="studio-link" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a><p class="studio-enquiry-note">Start by email. No call required.</p></div><ProjectBrief/></section>
</div>
