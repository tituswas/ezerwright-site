---
import {site} from '../config/site.mjs';
const copy=site.contact||{};
---
<form class="contact-form" action="/api/contact" method="post">
<div id="form-errors" class="form-errors" role="alert" tabindex="-1" hidden></div>
<div class="form-row"><div><label for="contact-name">{copy.nameLabel||'Your name'} <span>(required)</span></label><input id="contact-name" name="name" autocomplete="name" required maxlength="100"/><p class="field-error" id="error-name" hidden></p></div><div><label for="contact-email">{copy.emailLabel||'Email'} <span>(required)</span></label><input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254"/><p class="field-error" id="error-email" hidden></p></div></div>
<div class="form-row"><div><label for="contact-business">{copy.businessLabel||'Business name'} <span>(optional)</span></label><input id="contact-business" name="business" autocomplete="organization" maxlength="150"/><p class="field-error" id="error-business" hidden></p></div><div><label for="contact-service">{copy.serviceLabel||'What do you need?'}</label><select id="contact-service" name="service">{site.services.map(s=><option value={s.id}>{s.title}</option>)}<option value="other">Not sure yet</option></select><p class="field-error" id="error-service" hidden></p></div></div>
<label for="contact-message">{copy.messageLabel||(site.template==='client'?'How can we help?':'A little about the project')} <span>(required)</span></label><textarea id="contact-message" name="message" rows="5" required maxlength="2000"></textarea><p class="field-error" id="error-message" hidden></p>
<div class="honeypot" aria-hidden="true"><label for="contact-website">Leave this field empty</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off"/></div>
{site.mode==='production' && <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-action="contact"></div>}
{site.mode==='production' && <noscript><p>JavaScript is needed for spam verification. Please <a href={`mailto:${site.email}`}>email {site.email}</a> to discuss your project.</p></noscript>}
<p class="form-disclosure">We use these details to respond to your enquiry. <a href="/privacy/">Read the privacy notice.</a>{site.mode==='demo' && ' Use synthetic details only; this demonstration captures locally and sends no email.'}</p>
<button class="button" type="submit">{copy.submitLabel||(site.mode==='demo'?'Send test enquiry':'Send enquiry')} <span aria-hidden="true">↗</span></button>
<p id="form-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
</form>
