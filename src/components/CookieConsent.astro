<section class="cookie-choices" data-cookie-panel aria-labelledby="cookie-title" hidden>
  <div class="cookie-copy">
    <h2 id="cookie-title" tabindex="-1">Your cookie choices</h2>
    <p>Optional tracking stays off unless you accept. We currently use no optional analytics, advertising or session replay. Accepting saves your choice without enabling a tracking service.</p>
    <p class="cookie-detail">Essential functions support features you choose to use. You can change your choice at any time in Cookie settings. <a href="/privacy/#cookies">Read the cookie policy</a>.</p>
  </div>
  <div class="cookie-actions">
    <button type="button" data-cookie-choice="accepted">Accept optional</button>
    <button type="button" data-cookie-choice="rejected">Reject optional</button>
  </div>
  <p class="cookie-status" data-cookie-status role="status" aria-live="polite"></p>
</section>
