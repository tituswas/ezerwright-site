---
import {offer} from '../config/offer.mjs';
const groups=[
 {title:'What are we making?',hint:'Start with the kind of work you have in mind.',key:'service',options:[['website','A new website','A distinctive home for your business.'],['improvements','A better experience','Make your existing website work harder.'],['updates','A fresh chapter','Bring services, content and details up to date.']]},
 {title:'What should work better?',hint:'Choose the priority that matters most right now.',key:'goal',options:[['clarity','Make the offer clear','Help the right customer recognise a fit.'],['enquiries','Make enquiries easier','Give interest a clear next step.'],['mobile','Make mobile feel effortless','A considered experience on the smallest screen.']]},
 {title:'How should it feel?',hint:'A conversation starter, not a fixed template.',key:'direction',options:[['bold','Bold & expressive','Confident, high contrast, full of character.'],['calm','Calm & considered','Quiet space, clear detail, an easy rhythm.'],['editorial','Natural & editorial','Tactile, grounded, a story worth exploring.']]}
];
---
<nav aria-label="Project Room quick action"><a class="room-launcher" href="/contact/" data-room-open><span class="room-dot" aria-hidden="true"></span>Project Room <span aria-hidden="true">↗</span></a></nav>
<dialog class="project-room" aria-labelledby="room-title" data-room-fee={offer.totalUSD}>
 <div class="room-top"><span>EZERWRIGHT / PROJECT ROOM</span><button type="button" data-room-close aria-label="Close Project Room">×</button></div>
 <div class="room-grid"><div class="room-main"><p class="room-eyebrow">THREE CHOICES. A CLEARER START.</p><h2 id="room-title">What are we making?</h2><p data-room-hint>Start with the kind of work you have in mind.</p>
  <div class="room-progress" aria-label="Project brief progress"><span data-room-progress>01 / 03</span><i aria-hidden="true"></i></div>
  {groups.map((g,i)=><div data-room-step={i} hidden={i!==0} class="room-step" role="group" aria-label={g.title} data-room-heading={g.title} data-room-description={g.hint}>{g.options.map(([value,label,description],j)=><button type="button" data-room-key={g.key} data-room-value={value} aria-pressed={j===0?'true':'false'}><span><strong>{label}</strong><small>{description}</small></span><span class="room-choice-mark" aria-hidden="true">↗</span></button>)}</div>)}
  <div class="room-navigation"><button type="button" data-room-back hidden>← Back</button><button type="button" data-room-next>Next: your priority <span aria-hidden="true">→</span></button><a data-room-send hidden href="/contact/?service=website&amp;brief=website&amp;goal=clarity&amp;direction=bold">Continue to enquiry <span aria-hidden="true">↗</span></a></div>
  <p class="room-footnote">No personal details here. Nothing is sent until you submit an enquiry.</p><a class="room-skip" href="/contact/">Prefer to write freely? Go straight to contact ↗</a>
 </div><div class="room-summary"><div class="room-art" aria-hidden="true"><img data-room-art src="/art/living-exterior.webp" width="1536" height="1024" alt="" loading="lazy"/></div><div class="room-summary-content" aria-live="polite" aria-atomic="true"><p class="room-eyebrow">YOUR STARTING POINT</p><h3 data-room-summary-title>A new website</h3><dl><div><dt>Priority</dt><dd data-room-summary-goal>A clearer offer</dd></div><div><dt>Direction</dt><dd data-room-summary-direction>Bold &amp; expressive</dd></div><div><dt>Scope</dt><dd data-room-summary-price>US${offer.totalUSD} / defined five-page build</dd></div></dl><p data-room-summary-note>Two revision rounds. Portable source. Domain, hosting and additional work agreed separately.</p><span class="room-summary-label">A STARTER BRIEF · NOT AN ORDER</span></div></div></div>
</dialog>
