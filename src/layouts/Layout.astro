---
import {site} from '../config/site.mjs';
import {createHash} from 'node:crypto';
import {readFileSync} from 'node:fs';
import {pageSeo} from '../config/seo.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectRoom from '../components/ProjectRoom.astro';
import '../styles/site.css';
const {page}=Astro.props;
const {title,description,canonical,robots,schema}=pageSeo(site,page);
const theme=['ink','accent','surface','text'].map(k=>`--${k}:${site.theme[k]}`).join(';');
const agency=site.template!=='client';
// A new source asset gets a new URL; old browser/CDN copies cannot overwrite current copy.
const versionedAsset=path=>path+'?v='+createHash('sha256').update(readFileSync('public'+path)).digest('hex').slice(0,12);
const structuredData=JSON.stringify(schema).replace(/</g,'\\u003c');
---
<!doctype html>
<html lang="en" style={theme}>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="robots" content={robots}/>
  <meta name="color-scheme" content={agency?"dark":"light"}/>
  <link rel="canonical" href={canonical}/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:site_name" content={site.name}/>
  <meta name="twitter:card" content="summary"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={new URL('/og-card.svg',site.origin).href}/>
  <meta property="og:image:alt" content={site.name}/>
  <meta property="og:image" content={new URL('/og-card.svg',site.origin).href}/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  {agency&&page.slug===''&&<><link rel="stylesheet" href="/cinematic-home.css?v=typography-20261106"/><script src="/work-gallery.js?v=director-20261106" defer></script><link rel="stylesheet" href={versionedAsset('/project-room.css')}/><script src={versionedAsset('/project-room.js')} defer></script></>}
  {agency&&['services','approach','living','privacy'].includes(page.slug)&&<>
    <link rel="stylesheet" href="/interior-opening.css?v=typography-20261106"/>
    <link rel="stylesheet" href="/agency-interiors.css?v=typography-20261106"/>
  </>}
  {agency&&page.slug==='services'&&<link rel="stylesheet" href="/services-editorial.css?v=typography-20261106"/>}
  <link rel="preload" href="/fonts/manrope.woff" as="font" type="font/woff" crossorigin/>
  <script type="application/ld+json" set:html={structuredData}></script>
  <script src={versionedAsset('/ui.js')} defer></script>
  {agency&&['','contact'].includes(page.slug)&&<>
    <link rel="stylesheet" href="/project-brief.css?v=typography-20261106"/>
    <script src={versionedAsset('/project-brief.js')} defer></script>
  </>}
  {agency&&<>
    <link rel="stylesheet" href="/agency-refresh.css?v=typography-20261106"/>
    {page.slug.startsWith('plugins')&&<link rel="stylesheet" href="/plugin-refinements.css?v=typography-20261106"/>}
    <script src="/agency-motion.js" defer></script>
  </>}
  {agency&&page.slug==='contact'&&<link rel="stylesheet" href="/contact-desk.css?v=typography-20261106"/>}
  {agency&&<link rel="stylesheet" href={versionedAsset('/director.css')}/>}
  {site.mode==='production'&&<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</head>
<body class:list={[agency?'agency-experience approved-director':undefined,agency&&page.slug===''?'agency-home':undefined]}>
  <Header current={page.slug}/>
  <main id="main" tabindex="-1"><slot/></main>
  <Footer/>
  {agency&&page.slug===''&&<ProjectRoom/>}
</body>
</html>
